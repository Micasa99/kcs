# syntax=docker/dockerfile:1.7
ARG SOURCE_REVISION
FROM --platform=linux/amd64 golang:1.23.12-bookworm@sha256:e87b2a5f6df2dff71ea330d55d54f4979eb380ae58a7e3aabc9d53121243e689 AS build
ARG SOURCE_REVISION
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY native/launcher/go.mod native/launcher/go.sum ./
RUN go mod download
COPY native/launcher/main.go native/launcher/security_linux.go native/launcher/security_other.go ./
RUN test -n "$SOURCE_REVISION" \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/rc-native-launcher .

FROM scratch
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/TitiSkywalker/kcs" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="MIT"
COPY --from=build /out/rc-native-launcher /bin/rc-native-launcher
