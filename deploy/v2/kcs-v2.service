[Unit]
Description=Private port-forward to the KCS V2 TLS ClusterIP Service
After=k3s.service network-online.target
Requires=k3s.service

[Service]
Type=simple
EnvironmentFile=/etc/kcs-v2/port-forward.env
ExecStart=/usr/local/libexec/kcs-v2-port-forward ${KCS_PORT_FORWARD_ADDRESS} ${KCS_CONTROL_PRIVATE_ADDRESS}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
