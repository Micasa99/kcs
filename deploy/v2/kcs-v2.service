[Unit]
Description=Private port-forward to the KCS V2 TLS ClusterIP Service
After=k3s.service network-online.target
Requires=k3s.service

[Service]
Type=simple
EnvironmentFile=/etc/kcs-v2/port-forward.env
ExecStart=/bin/sh -ec 'test -n "$KCS_PORT_FORWARD_ADDRESS"; test "$KCS_PORT_FORWARD_ADDRESS" != "0.0.0.0"; test "$KCS_PORT_FORWARD_ADDRESS" != "::"; exec /usr/local/bin/k3s kubectl --namespace researchcosmos-v2 port-forward --address="$KCS_PORT_FORWARD_ADDRESS" service/kcs-v2-api 8443:443'
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
